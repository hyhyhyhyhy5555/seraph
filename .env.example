EXPO_PUBLIC_API_URL=http://localhost:4000

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://seraph:seraph@localhost:5432/seraph
PGHOST=localhost
PGPORT=5432
PGDATABASE=seraph
PGUSER=seraph
PGPASSWORD=seraph
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# Optional. Without a key, parsed manuals remain available to keyword search
# and the embedding worker can be run in --dry-run mode.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1200
